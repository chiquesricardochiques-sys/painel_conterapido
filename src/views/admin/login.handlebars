<div class="login-card">
    <div class="logo-area">
        <div class="logo-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
        </div>
        <h2>Painel do Salão</h2>
        <p class="subtitle">Digite o código do seu salão para ver a agenda</p>
    </div>

    {{#if error}}
        <div class="error-alert">
            {{error}}
        </div>
    {{/if}}

    <form action="/admin/login" method="POST" autocomplete="off">
        <div class="form-group">
            <label for="codigo">Código do salão</label>
            <input
                type="text"
                id="codigo"
                name="codigo"
                class="codigo-input"
                value="{{codigo}}"
                required
                maxlength="22"
                placeholder="#0815332"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                autofocus
            >
        </div>

        <button type="submit">Abrir agenda</button>
    </form>

    <p class="login-hint">O código é informado pelo responsável pelo salão.</p>
</div>