
<style>
    .servicos-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .servico-check {
        display: block;
    }
</style>

<div class="agendamento-form">
    <h2><i class="fas fa-calendar-check"></i> Agendar</h2>

    <!-- 🔧 antes cada card de horário tinha o próprio <form> e enviava
         sozinho ao clicar. Agora é um form único: profissional + serviço(s)
         + data + horário ficam guardados aqui dentro e só são enviados
         quando aperta "Agendar Horário" no final. -->
    <form id="agendamentoForm" method="POST" action="/client/schedule">

        <div class="step-header">
            <span class="step-number">1</span> Profissional e Serviço
        </div>

        <select name="profissional_id" id="profissionalSelect">
            {{#each profissionais}}
                <option value="{{this.id}}" {{#if (eq this.id ../selectedProfissional)}}selected{{/if}}>{{this.nome}}</option>
            {{/each}}
        </select>

        <!-- 🔧 checkboxes empilhados (display:block via .servico-check) -->
        <div id="servicosGroup" class="servicos-group" style="margin-top: 10px;">
            {{#each servicos}}
                <label class="servico-check">
                    <input
                        type="checkbox"
                        name="servico_ids"
                        class="servico-checkbox"
                        value="{{this.id}}"
                        {{#if (includes ../selectedServicos this.id)}}checked{{/if}}
                    >
                    {{this.nome}}
                </label>
            {{/each}}
        </div>

        <div class="step-header">
            <span class="step-number">4</span> Observações (opcional)
        </div>

        <textarea
            name="observacoes"
            placeholder="Descreva o corte se quiser (opcional)"
            style="width:100%; min-height:80px;"
        ></textarea>


        <div class="step-header">
            <span class="step-number">2</span> Selecione a Data
        </div>

        <div class="date-wrapper">
            <i class="fas fa-calendar-alt"></i>
            <input type="date" name="data" id="dataSelect" value="{{selectedData}}" min="{{currentDate}}" />
        </div>

        <div class="step-header">
        <span class="step-number">3</span>
        Escolha o Horário
        </div>

        <div id="horariosGrid" class="horarios-grid">

            {{#if horariosDisponiveis.length}}

                {{#each horariosDisponiveis}}

                    <label
                        class="horario-card {{status}}">

                        <input
                            type="radio"
                            name="hora"
                            value="{{hora}}"

                            {{#if (eq status "ocupado")}}
                                disabled
                            {{/if}}
                        >

                        <span class="hora">
                            {{hora}}
                        </span>

                    </label>

                {{/each}}

            {{else}}

                <div class="empty-notice">
                    Nenhum horário disponível.
                </div>

            {{/if}}

        </div>

        <!-- 🔧 botão único, fora da grade de horários -->
        <button type="submit" class="btn-agendar" id="btnAgendar" style="width:100%; margin-top:16px;">
            Agendar Horário
        </button>

    </form>
</div>

<script>
/**
 * Coleta os ids dos serviços marcados no momento
 */
function servicosSelecionados() {
    return Array.from(
        document.querySelectorAll('.servico-checkbox:checked')
    ).map(el => el.value);
}

/**
 * Função Principal para Atualizar os Horários via AJAX
 * 🔧 agora só monta radios (name="hora"), sem form/botão próprio —
 * o envio final é feito pelo #agendamentoForm inteiro.
 */
async function atualizarHorarios() {
    const profSelect = document.getElementById('profissionalSelect');
    const dataSelect = document.getElementById('dataSelect');
    const grid = document.getElementById('horariosGrid');

    const profId = profSelect.value;
    const dataValue = dataSelect.value;

    // Se não houver data selecionada, interrompe
    if (!dataValue) {
        grid.innerHTML = '<div class="empty-notice">Selecione uma data acima.</div>';
        return;
    }

    // Feedback de carregamento
    grid.innerHTML = '<div class="loader"><i class="fas fa-circle-notch fa-spin"></i> Buscando horários...</div>';

    try {
        const response = await fetch(`/client/ajax/horarios?profissional_id=${profId}&data=${dataValue}`);

        if (!response.ok) throw new Error('Erro na requisição');

        const horarios = await response.json();
        grid.innerHTML = ''; // Limpa o loader

        if (horarios.length === 0) {
            grid.innerHTML = '<div class="empty-notice">Nenhum horário disponível para este dia.</div>';
            return;
        }

        // Criar os cards para cada horário — agora um <label><input radio></label>
        horarios.forEach(h => {
            const estaDisponivel = h.disponivel;
            const servicosOcupando = (!estaDisponivel && h.servicos) ? h.servicos.join(', ') : '';

            const label = document.createElement('label');
            label.className = `horario-card ${estaDisponivel ? 'disponivel' : 'indisponivel'}`;
            if (servicosOcupando) label.title = servicosOcupando;

            label.innerHTML = `
                <input type="radio" name="hora" value="${h.hora}" ${estaDisponivel ? '' : 'disabled'}>
                <span class="hora">${h.hora}</span>
            `;

            grid.appendChild(label);
        });

    } catch (error) {
        console.error('Erro:', error);
        grid.innerHTML = '<div class="loader" style="color:var(--danger-red);">Erro ao carregar horários.</div>';
    }
}

// 🔧 valida que profissional + ao menos 1 serviço + data + horário foram
// escolhidos antes de deixar enviar o form único
document.getElementById('agendamentoForm').addEventListener('submit', (e) => {
    const servIds = servicosSelecionados();
    const horaMarcada = document.querySelector('input[name="hora"]:checked');

    if (servIds.length === 0) {
        e.preventDefault();
        alert('Selecione ao menos 1 serviço.');
        return;
    }

    if (!horaMarcada) {
        e.preventDefault();
        alert('Selecione um horário.');
        return;
    }
});

// Eventos de Escuta
document.getElementById('profissionalSelect').addEventListener('change', atualizarHorarios);
document.getElementById('dataSelect').addEventListener('change', atualizarHorarios);

// Execução inicial (Caso a página já carregue com valores)
window.addEventListener('load', () => {
    if(document.getElementById('dataSelect').value) {
        atualizarHorarios();
    }
});
</script>
