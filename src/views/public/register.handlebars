<!-- 
  Esta view deve ser renderizada usando o layout principal que contém 
  a classe 'login-page' no body e o script de inicialização dos ícones Lucide.
-->

<div class="login-card">
    <div class="header">
        <div class="logo-circle">
            <!-- Trocando shield-check por user-plus para cadastro -->
            <i data-lucide="user-plus"></i>
        </div>
        <h2>Crie sua conta</h2>
        <p class="subtitle">Preencha os dados para se cadastrar</p>
    </div>

    {{#if error}}
        <!-- Usando a classe .error-toast definida no CSS do login -->
        <div class="error-toast" role="alert">
            <i data-lucide="alert-circle" style="width: 16px;"></i>
            {{error}}
        </div>
    {{/if}}

    {{#if success}}
        <!-- Reutilizando o estilo de erro, mas com cor de sucesso (ajustado no CSS se necessário) -->
        <div class="error-toast success" role="alert" style="color:var(--accent-green); border-color:var(--accent-green-subtle); background: var(--accent-green-bg);">
            <i data-lucide="check-circle" style="width: 16px;"></i>
            {{success}}
        </div>
    {{/if}}

    <form action="/register" method="POST">
        
        <!-- Campo Nome -->
        <div class="form-group">
            <div class="input-wrapper">
                <i data-lucide="user"></i>
                <input type="text" name="nome" required placeholder="Seu nome completo">
            </div>
        </div>

        <!-- Campo Email -->
        <div class="form-group">
            <div class="input-wrapper">
                <i data-lucide="mail"></i>
                <input type="email" name="email" required placeholder="Seu melhor email">
            </div>
        </div>

        <!-- Campo Telefone (Opcional) -->
        <div class="form-group">
            <div class="input-wrapper">
                <i data-lucide="phone"></i>
                <input type="text" name="telefone" placeholder="(99) 99999-9999">
            </div>
        </div>

        <!-- Campo Senha -->
        <div class="form-group">
            <div class="input-wrapper">
                <i data-lucide="lock"></i>
                <input type="password" name="senha" required placeholder="Crie uma senha segura">
            </div>
        </div>

        <!-- Botão de Cadastro (usa as mesmas classes do botão de login) -->
        <button type="submit">
            Cadastrar
            <i data-lucide="arrow-right" style="width: 18px;"></i>
        </button>
    </form>

    <!-- Footer Links (centralizado igual ao login) -->
    <div class="footer-links" style="justify-content: center;">
        <p>
            Já tem conta?
            <a href="/login" style="color:var(--primary-blue); font-weight:600;">Faça login</a>
        </p>
    </div>
</div>

<!-- O script lucide.createIcons(); deve estar no layout principal -->